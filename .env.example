# Where the Vite dev proxy forwards /backend/* requests (Spring Boot).
BACKEND_URL=http://localhost:8081

# Base URL the browser uses for API calls. Keep "/backend" in dev (uses the proxy).
# For a production build served separately, set the real backend URL, e.g.
# VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=/backend
